# ---------------------------------------------------------------------------
# Retail Suite environment. Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# PostgreSQL connection (Docker Compose exposes postgres on 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_dev
# Used only by the integration test suite; it is reset on every run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_test
DATABASE_POOL_SIZE=10

# API server
API_PORT=3000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# JWT signing secret for short-lived access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required (min 32 chars) when NODE_ENV=production.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Private file storage. "local" writes under STORAGE_LOCAL_DIR (outside the
# web root, served only through authorised API endpoints).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880

# Mobile money. "simulator" is a clearly labelled development simulator; no
# real money moves. Live adapters require provider credentials (Phase 4).
MOBILE_MONEY_MODE=simulator
# Seconds before a pending electronic payment attempt times out and is
# reconciled by the worker.
PAYMENT_ATTEMPT_TIMEOUT_SECONDS=180
# Shared secret used to verify simulator/provider webhook signatures.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Worker polling interval (milliseconds)
WORKER_POLL_MS=2000

# Production first-run setup (pnpm setup:production). The owner password must
# be supplied at run time; it is never defaulted.
SETUP_BUSINESS_NAME=
SETUP_OWNER_EMAIL=
SETUP_OWNER_PASSWORD=

# Platforms such as Laravel Cloud inject DB_CONNECTION=pgsql, DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, DB_PASSWORD instead of DATABASE_URL — these are used
# automatically when DATABASE_URL is not set (sslmode=require for remote hosts;
# override with DB_SSLMODE).
