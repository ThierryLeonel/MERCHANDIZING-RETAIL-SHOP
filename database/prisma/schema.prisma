/// A tender against a sale (or a customer account receipt). Electronic
/// methods start PENDING and become CONFIRMED only through a provider
/// callback or an authorised manual confirmation with reference.
model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  business_id          String        @db.Uuid
  branch_id            String        @db.Uuid
  sale_id              String?       @db.Uuid
  customer_id          String?       @db.Uuid
  cashier_session_id   String?       @db.Uuid
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(18, 2)
  amount_tendered      Decimal?      @db.Decimal(18, 2)
  change_given         Decimal       @default(0) @db.Decimal(18, 2)
  financial_account_id String?       @db.Uuid
  provider             String?       @db.VarChar(32)
  provider_reference   String?
  payer_phone          String?
  confirmation_mode    String?       @db.VarChar(16)
  confirmed_by_id      String?       @db.Uuid
  confirmed_at         DateTime?     @db.Timestamptz(6)
  failure_reason       String?
  created_by_id        String        @db.Uuid
  created_at           DateTime      @default(now()) @db.Timestamptz(6)

  sale     Sale?            @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]

  @@index([sale_id])
  @@index([status, method])
  @@map("payments")
}

