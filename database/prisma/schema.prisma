  inspection_notes  String?
  location_id       String?         @db.Uuid
  net_refund        Decimal         @db.Decimal(18, 2)
  tax_refund        Decimal         @db.Decimal(18, 2)
  unit_cost         Decimal         @db.Decimal(18, 6)
  cost_amount       Decimal         @db.Decimal(18, 2)
  serial_number_id  String?         @db.Uuid

  sales_return SalesReturn @relation(fields: [sales_return_id], references: [id], onDelete: Restrict)

  @@map("sales_return_lines")
}

model Refund {
  id                   String        @id @default(uuid()) @db.Uuid
  business_id          String        @db.Uuid
  sales_return_id      String        @db.Uuid
  method               PaymentMethod
  status               PaymentStatus @default(CONFIRMED)
  amount               Decimal       @db.Decimal(18, 2)
  financial_account_id String?       @db.Uuid
  reference            String?
  cashier_session_id   String?       @db.Uuid
  created_by_id        String        @db.Uuid
  created_at           DateTime      @default(now()) @db.Timestamptz(6)

  @@map("refunds")
}

// --------------------------------------------------------- customers ----

model CustomerGroup {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  name        String
  price_list_kind PriceListKind @default(RETAIL)

  @@unique([business_id, name])
  @@map("customer_groups")
}

model Customer {
  id                 String       @id @default(uuid()) @db.Uuid
  business_id        String       @db.Uuid
  code               String       @db.VarChar(24)
  name               String
  phone              String?
  email              String?
  address            String?
  customer_group_id  String?      @db.Uuid
  credit_status      CreditStatus @default(NONE)
  credit_limit       Decimal      @default(0) @db.Decimal(18, 2)
  payment_terms_days Int          @default(0)
  active             Boolean      @default(true)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@index([business_id, phone])
  @@map("customers")
}

// ----------------------------------------------------------- finance ----

model FinancialAccount {
  id            String               @id @default(uuid()) @db.Uuid
  business_id   String               @db.Uuid
  branch_id     String?              @db.Uuid
  code          String               @db.VarChar(24)
  name          String
  kind          FinancialAccountKind
  gl_account_id String               @db.Uuid
  provider      String?              @db.VarChar(32)
  active        Boolean              @default(true)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("financial_accounts")
}

model CashRegister {
  id              String   @id @default(uuid()) @db.Uuid
  business_id     String   @db.Uuid
  branch_id       String   @db.Uuid
  location_id     String   @db.Uuid
  code            String   @db.VarChar(16)
  name            String
  till_account_id String   @db.Uuid
  device_token_hash String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([branch_id, code])
  @@map("cash_registers")
}

model CashierSession {
  id                  String        @id @default(uuid()) @db.Uuid
  business_id         String        @db.Uuid
  branch_id           String        @db.Uuid
  register_id         String        @db.Uuid
  user_id             String        @db.Uuid
  number              String        @db.VarChar(32)
  status              SessionStatus @default(OPEN)
  opened_at           DateTime      @default(now()) @db.Timestamptz(6)
  opening_float       Decimal       @db.Decimal(18, 2)
  float_source_account_id String?   @db.Uuid
  closed_at           DateTime?     @db.Timestamptz(6)
  expected_cash       Decimal?      @db.Decimal(18, 2)
  counted_cash        Decimal?      @db.Decimal(18, 2)
  variance            Decimal?      @db.Decimal(18, 2)
  variance_reason     String?
  variance_approval_id String?      @db.Uuid
  closing_transfer_account_id String? @db.Uuid
  closing_journal_id  String?       @db.Uuid
  closed_by_id        String?       @db.Uuid

  @@unique([business_id, number])
  @@index([register_id, status])
  @@map("cashier_sessions")
}

model CashMovement {
  id                  String           @id @default(uuid()) @db.Uuid
  business_id         String           @db.Uuid
  cashier_session_id  String           @db.Uuid
  kind                CashMovementKind
  amount              Decimal          @db.Decimal(18, 2)
  counter_account_id  String?          @db.Uuid
  expense_account_id  String?          @db.Uuid
  reason              String
  approval_request_id String?          @db.Uuid
  journal_entry_id    String?          @db.Uuid
  created_by_id       String           @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)

  @@index([cashier_session_id])
  @@map("cash_movements")
}

model CashCount {
  id                 String   @id @default(uuid()) @db.Uuid
  cashier_session_id String   @db.Uuid
  denominations      Json     @default("{}")
  total              Decimal  @db.Decimal(18, 2)
  counted_by_id      String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("cash_counts")
}

/// Internal transfer between financial accounts (e.g. till → safe → bank).
model FundsTransfer {
  id               String   @id @default(uuid()) @db.Uuid
  business_id      String   @db.Uuid
  number           String   @db.VarChar(32)
  from_account_id  String   @db.Uuid
  to_account_id    String   @db.Uuid
  amount           Decimal  @db.Decimal(18, 2)
  fee_amount       Decimal  @default(0) @db.Decimal(18, 2)
  reference        String?
  transfer_date    DateTime @db.Date
  journal_entry_id String?  @db.Uuid
  created_by_id    String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, number])
  @@map("funds_transfers")
}

/// Provider settlement (gross collections, fees, net payout). Phase 2.
model Settlement {
  id                   String   @id @default(uuid()) @db.Uuid
  business_id          String   @db.Uuid
  number               String   @db.VarChar(32)
  provider             String   @db.VarChar(32)
  clearing_account_id  String   @db.Uuid
  destination_account_id String @db.Uuid
  gross_amount         Decimal  @db.Decimal(18, 2)
  fee_amount           Decimal  @db.Decimal(18, 2)
  net_amount           Decimal  @db.Decimal(18, 2)
  settlement_date      DateTime @db.Date
  reference            String?
  journal_entry_id     String?  @db.Uuid
  created_by_id        String   @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  lines SettlementLine[]

  @@unique([business_id, number])
  @@map("settlements")
}

model SettlementLine {
  id            String  @id @default(uuid()) @db.Uuid
  settlement_id String  @db.Uuid
  payment_id    String  @db.Uuid
  amount        Decimal @db.Decimal(18, 2)

  settlement Settlement @relation(fields: [settlement_id], references: [id], onDelete: Restrict)

  @@unique([payment_id])
  @@map("settlement_lines")
}

model Reconciliation {
  id                   String   @id @default(uuid()) @db.Uuid
  business_id          String   @db.Uuid
  financial_account_id String   @db.Uuid
  statement_date       DateTime @db.Date
  statement_balance    Decimal  @db.Decimal(18, 2)
  book_balance         Decimal  @db.Decimal(18, 2)
  difference           Decimal  @db.Decimal(18, 2)
  status               String   @default("DRAFT") @db.VarChar(16)
  created_by_id        String   @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  lines ReconciliationLine[]

  @@map("reconciliations")
}

model ReconciliationLine {
  id                String  @id @default(uuid()) @db.Uuid
  reconciliation_id String  @db.Uuid
  journal_line_id   String  @db.Uuid
  cleared           Boolean @default(true)

  reconciliation Reconciliation @relation(fields: [reconciliation_id], references: [id], onDelete: Restrict)

  @@map("reconciliation_lines")
}

// -------------------------------------------------------- accounting ----

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  business_id    String      @db.Uuid
  code           String      @db.VarChar(16)
  name           String
  type           AccountType
  subtype        String?     @db.VarChar(32)
  parent_id      String?     @db.Uuid
  is_control     Boolean     @default(false)
  is_postable    Boolean     @default(true)
  allow_manual   Boolean     @default(true)
  active         Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("accounts")
}

model FiscalPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  business_id  String       @db.Uuid
  name         String       @db.VarChar(32)
  start_date   DateTime     @db.Date
  end_date     DateTime     @db.Date
  status       PeriodStatus @default(OPEN)
  closed_by_id String?      @db.Uuid
  closed_at    DateTime?    @db.Timestamptz(6)

  @@unique([business_id, start_date])
  @@map("fiscal_periods")
}

model JournalEntry {
  id               String         @id @default(uuid()) @db.Uuid
  business_id      String         @db.Uuid
  branch_id        String?        @db.Uuid
  number           String         @db.VarChar(32)
  entry_date       DateTime       @db.Date
  fiscal_period_id String         @db.Uuid
  source_type      String         @db.VarChar(40)
  source_id        String?        @db.Uuid
  source_number    String?        @db.VarChar(32)
  description      String
  status           DocumentStatus @default(POSTED)
  is_manual        Boolean        @default(false)
  total_debit      Decimal        @db.Decimal(18, 2)
  total_credit     Decimal        @db.Decimal(18, 2)
  reversal_of_id   String?        @db.Uuid
  reversed_by_id   String?        @db.Uuid
  approval_request_id String?     @db.Uuid
  created_by_id    String         @db.Uuid
  posted_at        DateTime       @default(now()) @db.Timestamptz(6)

  lines JournalLine[]

  @@unique([business_id, number])
  @@index([business_id, entry_date])
  @@index([source_type, source_id])
  @@map("journal_entries")
}

model JournalLine {
  id                   String  @id @default(uuid()) @db.Uuid
  journal_entry_id     String  @db.Uuid
  line_no              Int
  account_id           String  @db.Uuid
  branch_id            String? @db.Uuid
  debit                Decimal @default(0) @db.Decimal(18, 2)
  credit               Decimal @default(0) @db.Decimal(18, 2)
  memo                 String?
  supplier_id          String? @db.Uuid
  customer_id          String? @db.Uuid
  financial_account_id String? @db.Uuid

  journal_entry JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: Restrict)

  @@unique([journal_entry_id, line_no])
  @@index([account_id])
  @@index([supplier_id])
  @@index([customer_id])
  @@map("journal_lines")
}

/// Maps posting events (e.g. "inventory", "grni", "sales_revenue") to
/// accounts so the posting matrix is configuration, not code.
model PostingRule {
  id          String @id @default(uuid()) @db.Uuid
  business_id String @db.Uuid
  key         String @db.VarChar(48)
  account_id  String @db.Uuid
  description String

  @@unique([business_id, key])
  @@map("posting_rules")
}

model ExpenseCategory {
  id          String  @id @default(uuid()) @db.Uuid
  business_id String  @db.Uuid
  name        String
  account_id  String  @db.Uuid
  active      Boolean @default(true)

  @@unique([business_id, name])
  @@map("expense_categories")
}

model Expense {
  id                   String         @id @default(uuid()) @db.Uuid
  business_id          String         @db.Uuid
  branch_id            String         @db.Uuid
  number               String         @db.VarChar(32)
  expense_date         DateTime       @db.Date
  payee                String
  financial_account_id String         @db.Uuid
  reference            String?
  total                Decimal        @db.Decimal(18, 2)
  status               DocumentStatus @default(POSTED)
  journal_entry_id     String?        @db.Uuid
  approval_request_id  String?        @db.Uuid
  created_by_id        String         @db.Uuid
  created_at           DateTime       @default(now()) @db.Timestamptz(6)

  lines ExpenseLine[]

  @@unique([business_id, number])
  @@map("expenses")
}

model ExpenseLine {
  id                  String  @id @default(uuid()) @db.Uuid
  expense_id          String  @db.Uuid
  expense_category_id String  @db.Uuid
  description         String
  amount              Decimal @db.Decimal(18, 2)

  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Restrict)

  @@map("expense_lines")
}

// ------------------------------------------ governance & integrations ----

model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  business_id     String         @db.Uuid
  branch_id       String?        @db.Uuid
  number          String         @db.VarChar(32)
  request_type    String         @db.VarChar(48)
  status          ApprovalStatus @default(PENDING)
  subject_type    String?        @db.VarChar(40)
  subject_id      String?        @db.Uuid
  amount          Decimal?       @db.Decimal(18, 2)
  payload         Json           @default("{}")
  reason          String
  requested_by_id String         @db.Uuid
  decided_by_id   String?        @db.Uuid
  decided_at      DateTime?      @db.Timestamptz(6)
  decision_note   String?
  consumed_at     DateTime?      @db.Timestamptz(6)
  expires_at      DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  actions ApprovalAction[]

  @@unique([business_id, number])
  @@index([business_id, status])
  @@map("approval_requests")
}

model ApprovalAction {
  id                  String   @id @default(uuid()) @db.Uuid
  approval_request_id String   @db.Uuid
  actor_id            String   @db.Uuid
  action              String   @db.VarChar(16)
  note                String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  approval_request ApprovalRequest @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)

  @@map("approval_actions")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String?  @db.Uuid
  branch_id   String?  @db.Uuid
  actor_id    String?  @db.Uuid
  action      String   @db.VarChar(64)
  entity_type String   @db.VarChar(40)
  entity_id   String?  @db.Uuid
  summary     String
  data        Json     @default("{}")
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([business_id, created_at])
  @@index([entity_type, entity_id])
  @@map("audit_events")
}

model Attachment {
  id            String   @id @default(uuid()) @db.Uuid
  business_id   String   @db.Uuid
  owner_type    String   @db.VarChar(40)
  owner_id      String?  @db.Uuid
  storage_key   String
  file_name     String
  mime_type     String   @db.VarChar(100)
  size_bytes    Int
  uploaded_by_id String  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id])
  @@map("attachments")
}

model IntegrationConnection {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  provider    String   @db.VarChar(32)
  kind        String   @db.VarChar(32)
  mode        String   @default("SIMULATOR") @db.VarChar(16)
  config      Json     @default("{}")
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, provider])
  @@map("integration_connections")
}

model WebhookInbox {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(32)
  external_id String
  signature_ok Boolean  @default(false)
  payload     Json
  status      String    @default("RECEIVED") @db.VarChar(16)
  received_at DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)

  @@unique([provider, external_id])
  @@map("webhook_inbox")
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.Uuid
  business_id  String?      @db.Uuid
  topic        String       @db.VarChar(64)
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  available_at DateTime     @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?    @db.Timestamptz(6)
  processed_at DateTime?    @db.Timestamptz(6)
  last_error   String?
  created_at   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, available_at])
  @@map("outbox_events")
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(64)
  last_run_at DateTime? @db.Timestamptz(6)
  last_status String?   @db.VarChar(16)
  last_error  String?
  run_count   Int       @default(0)

  @@map("background_jobs")
}

model IdempotencyRecord {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  key           String   @db.VarChar(80)
  route         String   @db.VarChar(120)
  request_hash  String   @db.VarChar(64)
  status_code   Int?
  response_body Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, key, route])
  @@map("idempotency_records")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  branch_id   String?   @db.Uuid
  kind        String    @db.VarChar(32)
  title       String
  body        String
  link        String?
  dedupe_key  String?   @db.VarChar(120)
  read_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([business_id, dedupe_key])
  @@map("notifications")
}
