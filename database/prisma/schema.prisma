// =============================================================================
// Retail Suite — database schema
// -----------------------------------------------------------------------------
// Conventions (see documentation/architecture/database.md):
//  * Table names: snake_case plural (@@map). Column names: snake_case.
//  * IDs: UUID. Human document numbers live in `number` columns.
//  * Money: Decimal(18,2). Quantities: Decimal(18,3). Unit costs: Decimal(18,6).
//    Never use floating point for money or quantity.
//  * Timestamps: timestamptz stored in UTC; displayed in business timezone.
//  * Columns ending in _id / _by_id without a Prisma relation still receive a
//    real FOREIGN KEY ... ON DELETE RESTRICT, generated by
//    packages/db/tools/generate-ddl.ts from its explicit column→table map.
//  * Posted records are never deleted (no cascades; triggers block UPDATE of
//    posted journals and all DELETE on ledgers — see migration 0002).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../packages/db/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------- enums ----

enum BranchKind {
  STORE
  WAREHOUSE
}

enum LocationKind {
  SALES_FLOOR
  STOREROOM
  QUARANTINE
  DAMAGED
  TRANSIT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductType {
  STANDARD
  VARIANT
  PREPACKED_SET
  VIRTUAL_BUNDLE
  ASSEMBLED_KIT
  NON_STOCK
}

enum RecordStatus {
  ACTIVE
  DISCONTINUED
}

enum PriceListKind {
  RETAIL
  WHOLESALE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

enum ReceiptStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum InvoiceStatus {
  NOT_INVOICED
  PARTIALLY_INVOICED
  FULLY_INVOICED
}

enum DocumentStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum MovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUSTMENT
  ADJUSTMENT
  DAMAGE
  EXPIRY
  RELOCATION
  KIT_ASSEMBLY
  KIT_DISASSEMBLY
  REVERSAL
}

enum TransferStatus {
  DRAFT
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum CountStatus {
  DRAFT
  COUNTING
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

enum SaleStatus {
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  CUSTOMER_CREDIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum ReturnCondition {
  SELLABLE
  QUARANTINED
  DAMAGED
  SUPPLIER_RETURN_PENDING
  NON_RESTOCKABLE
}

enum FinancialAccountKind {
  TILL
  SAFE
  PETTY_CASH
  BANK
  MOBILE_MONEY
  CLEARING
}

enum SessionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum CashMovementKind {
  OPENING_FLOAT
  PAID_OUT
  CASH_DROP
  CASH_IN
  REFUND
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CONSUMED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum CreditStatus {
  NONE
  ACTIVE
  ON_HOLD
}

// ------------------------------------------------------ organisation ----

model Business {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  legal_name            String?
  tax_id                String?
  phone                 String?
  email                 String?
  address               String?
  country_code          String   @default("CM") @db.VarChar(2)
  currency_code         String   @default("XAF") @db.VarChar(3)
  currency_decimals     Int      @default(0)
  timezone              String   @default("Africa/Douala")
  locale                String   @default("en")
  prices_include_tax    Boolean  @default(false)
  allow_negative_stock  Boolean  @default(false)
  costing_scope         String   @default("BRANCH")
  receipt_footer        String?
  settings              Json     @default("{}")
  is_demo               Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  branches Branch[]

  @@map("businesses")
}

model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  business_id String     @db.Uuid
  code        String     @db.VarChar(16)
  name        String
  kind        BranchKind @default(STORE)
  phone       String?
  address     String?
  active      Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)

  business  Business   @relation(fields: [business_id], references: [id], onDelete: Restrict)
  locations Location[]

  @@unique([business_id, code])
  @@map("branches")
}

model Location {
  id          String       @id @default(uuid()) @db.Uuid
  business_id String       @db.Uuid
  branch_id   String       @db.Uuid
  code        String       @db.VarChar(24)
  name        String
  kind        LocationKind @default(SALES_FLOOR)
  is_sellable Boolean      @default(true)
  is_default  Boolean      @default(false)
  active      Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@unique([branch_id, code])
  @@map("locations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  business_id        String     @db.Uuid
  email              String
  full_name          String
  phone              String?
  password_hash      String
  pin_hash           String?
  status             UserStatus @default(ACTIVE)
  default_branch_id  String?    @db.Uuid
  all_branches       Boolean    @default(false)
  mfa_secret         String?
  mfa_enabled        Boolean    @default(false)
  must_change_password Boolean  @default(false)
  failed_logins      Int        @default(0)
  locked_until       DateTime?  @db.Timestamptz(6)
  last_login_at      DateTime?  @db.Timestamptz(6)
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime   @updatedAt @db.Timestamptz(6)

  roles         UserRole[]
  branch_access UserBranchAccess[]

  @@unique([business_id, email])
  @@map("users")
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String
  user_agent         String?
  ip_address         String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at       DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  revoked_reason     String?

  @@index([user_id])
  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  code        String   @db.VarChar(48)
  name        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([business_id, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(64)
  module      String @db.VarChar(32)
  description String
  sensitive   Boolean @default(false)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id String @db.Uuid
  role_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model UserBranchAccess {
  user_id   String @db.Uuid
  branch_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@id([user_id, branch_id])
  @@map("user_branch_access")
}

model ApprovalPolicy {
  id                  String   @id @default(uuid()) @db.Uuid
  business_id         String   @db.Uuid
  request_type        String   @db.VarChar(48)
  enabled             Boolean  @default(true)
  threshold_amount    Decimal? @db.Decimal(18, 2)
  threshold_percent   Decimal? @db.Decimal(7, 4)
  approver_permission String   @db.VarChar(64)
  allow_self_approval Boolean  @default(false)
  description         String?

  @@unique([business_id, request_type])
  @@map("approval_policies")
}

model DocumentSequence {
  id          String @id @default(uuid()) @db.Uuid
  business_id String @db.Uuid
  scope       String @db.VarChar(64)
  prefix      String @db.VarChar(24)
  next_value  Int    @default(1)
  padding     Int    @default(6)

  @@unique([business_id, scope])
  @@map("document_sequences")
}

// --------------------------------------------------------- catalogue ----

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  code        String   @db.VarChar(24)
  name        String
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("departments")
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  business_id   String   @db.Uuid
  department_id String?  @db.Uuid
  parent_id     String?  @db.Uuid
  code          String   @db.VarChar(32)
  name          String
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  name        String
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, name])
  @@map("brands")
}

model Unit {
  id          String @id @default(uuid()) @db.Uuid
  business_id String @db.Uuid
  code        String @db.VarChar(16)
  name        String

  @@unique([business_id, code])
  @@map("units")
}

model TaxRate {
  id                String   @id @default(uuid()) @db.Uuid
  business_id       String   @db.Uuid
  code              String   @db.VarChar(24)
  name              String
  rate_percent      Decimal  @db.Decimal(7, 4)
  output_account_id String?  @db.Uuid
  input_account_id  String?  @db.Uuid
  active            Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("tax_rates")
}

model Product {
  id            String       @id @default(uuid()) @db.Uuid
  business_id   String       @db.Uuid
  code          String       @db.VarChar(32)
  name          String
  description   String?
  product_type  ProductType  @default(STANDARD)
  department_id String?      @db.Uuid
  category_id   String?      @db.Uuid
  brand_id      String?      @db.Uuid
  base_unit_id  String       @db.Uuid
  tax_rate_id   String?      @db.Uuid
  track_batches Boolean      @default(false)
  track_expiry  Boolean      @default(false)
  track_serials Boolean      @default(false)
  warranty_months Int?
  image_attachment_id String? @db.Uuid
  status        RecordStatus @default(ACTIVE)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)

  variants ProductVariant[]

  @@unique([business_id, code])
  @@index([business_id, name])
  @@map("products")
}

model ProductVariant {
  id                    String       @id @default(uuid()) @db.Uuid
  business_id           String       @db.Uuid
  product_id            String       @db.Uuid
  sku                   String       @db.VarChar(48)
  name                  String
  retail_price          Decimal      @db.Decimal(18, 2)
  wholesale_price       Decimal?     @db.Decimal(18, 2)
  min_price             Decimal?     @db.Decimal(18, 2)
  reorder_point         Decimal      @default(0) @db.Decimal(18, 3)
  reorder_qty           Decimal      @default(0) @db.Decimal(18, 3)
  preferred_supplier_id String?      @db.Uuid
  is_shortcut           Boolean      @default(false)
  status                RecordStatus @default(ACTIVE)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @updatedAt @db.Timestamptz(6)

  product          Product                 @relation(fields: [product_id], references: [id], onDelete: Restrict)
  barcodes         Barcode[]
  unit_conversions VariantUnitConversion[]
  attribute_values VariantAttributeValue[]

  @@unique([business_id, sku])
  @@index([product_id])
  @@map("product_variants")
}

model Attribute {
  id          String @id @default(uuid()) @db.Uuid
  business_id String @db.Uuid
  code        String @db.VarChar(32)
  name        String

  values AttributeValue[]

  @@unique([business_id, code])
  @@map("attributes")
}

model AttributeValue {
  id           String @id @default(uuid()) @db.Uuid
  attribute_id String @db.Uuid
  value        String
  sort_order   Int    @default(0)

  attribute Attribute               @relation(fields: [attribute_id], references: [id], onDelete: Restrict)
  variants  VariantAttributeValue[]

  @@unique([attribute_id, value])
  @@map("attribute_values")
}

model VariantAttributeValue {
  variant_id         String @db.Uuid
  attribute_value_id String @db.Uuid

  variant         ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  attribute_value AttributeValue @relation(fields: [attribute_value_id], references: [id], onDelete: Restrict)

  @@id([variant_id, attribute_value_id])
  @@map("variant_attribute_values")
}

/// Packaging conversion: 1 <unit> of this variant = factor base units.
model VariantUnitConversion {
  id                  String  @id @default(uuid()) @db.Uuid
  variant_id          String  @db.Uuid
  unit_id             String  @db.Uuid
  factor              Decimal @db.Decimal(18, 3)
  is_purchase_default Boolean @default(false)
  is_sellable         Boolean @default(false)

  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@unique([variant_id, unit_id])
  @@map("variant_unit_conversions")
}

model Barcode {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  variant_id  String   @db.Uuid
  code        String   @db.VarChar(64)
  unit_id     String?  @db.Uuid
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@unique([business_id, code])
  @@map("barcodes")
}

/// Components of VIRTUAL_BUNDLE / ASSEMBLED_KIT variants (Phase 3 workflows).
model BundleComponent {
  id                   String  @id @default(uuid()) @db.Uuid
  bundle_variant_id    String  @db.Uuid
  component_variant_id String  @db.Uuid
  quantity             Decimal @db.Decimal(18, 3)

  @@unique([bundle_variant_id, component_variant_id])
  @@map("bundle_components")
}

// ----------------------------------------------------------- pricing ----

model PriceList {
  id          String        @id @default(uuid()) @db.Uuid
  business_id String        @db.Uuid
  code        String        @db.VarChar(24)
  name        String
  kind        PriceListKind @default(RETAIL)
  branch_id   String?       @db.Uuid
  active      Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  items PriceListItem[]

  @@unique([business_id, code])
  @@map("price_lists")
}

model PriceListItem {
  id             String    @id @default(uuid()) @db.Uuid
  price_list_id  String    @db.Uuid
  variant_id     String    @db.Uuid
  price          Decimal   @db.Decimal(18, 2)
  min_price      Decimal?  @db.Decimal(18, 2)
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  created_by_id  String?   @db.Uuid

  price_list PriceList @relation(fields: [price_list_id], references: [id], onDelete: Restrict)

  @@index([variant_id, price_list_id, effective_from])
  @@map("price_list_items")
}

/// Phase 3: promotions engine. Schema present; no user-facing workflow yet.
model Promotion {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  code        String    @db.VarChar(32)
  name        String
  branch_id   String?   @db.Uuid
  priority    Int       @default(100)
  stackable   Boolean   @default(false)
  starts_at   DateTime  @db.Timestamptz(6)
  ends_at     DateTime? @db.Timestamptz(6)
  active      Boolean   @default(true)

  rules PromotionRule[]

  @@unique([business_id, code])
  @@map("promotions")
}

model PromotionRule {
  id             String   @id @default(uuid()) @db.Uuid
  promotion_id   String   @db.Uuid
  variant_id     String?  @db.Uuid
  category_id    String?  @db.Uuid
  percent_off    Decimal? @db.Decimal(7, 4)
  amount_off     Decimal? @db.Decimal(18, 2)
  min_quantity   Decimal  @default(1) @db.Decimal(18, 3)

  promotion Promotion @relation(fields: [promotion_id], references: [id], onDelete: Restrict)

  @@map("promotion_rules")
}

// -------------------------------------------------------- purchasing ----

model Supplier {
  id                 String   @id @default(uuid()) @db.Uuid
  business_id        String   @db.Uuid
  code               String   @db.VarChar(24)
  name               String
  contact_name       String?
  phone              String?
  email              String?
  address            String?
  tax_id             String?
  payment_terms_days Int      @default(0)
  active             Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([business_id, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id                  String              @id @default(uuid()) @db.Uuid
  business_id         String              @db.Uuid
  branch_id           String              @db.Uuid
  supplier_id         String              @db.Uuid
  number              String              @db.VarChar(32)
  status              PurchaseOrderStatus @default(DRAFT)
  receipt_status      ReceiptStatus       @default(NOT_RECEIVED)
  invoice_status      InvoiceStatus       @default(NOT_INVOICED)
  order_date          DateTime            @db.Date
  expected_date       DateTime?           @db.Date
  payment_type        String              @default("CREDIT") @db.VarChar(16)
  notes               String?
  subtotal            Decimal             @default(0) @db.Decimal(18, 2)
  tax_total           Decimal             @default(0) @db.Decimal(18, 2)
  total               Decimal             @default(0) @db.Decimal(18, 2)
  created_by_id       String              @db.Uuid
  submitted_at        DateTime?           @db.Timestamptz(6)
  approved_by_id      String?             @db.Uuid
  approved_at         DateTime?           @db.Timestamptz(6)
  approval_request_id String?             @db.Uuid
  closed_at           DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @updatedAt @db.Timestamptz(6)

  lines PurchaseOrderLine[]

  @@unique([business_id, number])
  @@index([business_id, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  purchase_order_id String   @db.Uuid
  line_no           Int
  variant_id        String   @db.Uuid
  unit_id           String   @db.Uuid
  unit_factor       Decimal  @db.Decimal(18, 3)
  quantity          Decimal  @db.Decimal(18, 3)
  quantity_base     Decimal  @db.Decimal(18, 3)
  unit_cost         Decimal  @db.Decimal(18, 6)
  tax_rate_id       String?  @db.Uuid
  tax_percent       Decimal  @default(0) @db.Decimal(7, 4)
  line_subtotal     Decimal  @db.Decimal(18, 2)
  line_tax          Decimal  @default(0) @db.Decimal(18, 2)
  received_base     Decimal  @default(0) @db.Decimal(18, 3)
  invoiced_base     Decimal  @default(0) @db.Decimal(18, 3)

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Restrict)

  @@unique([purchase_order_id, line_no])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id                String         @id @default(uuid()) @db.Uuid
  business_id       String         @db.Uuid
  branch_id         String         @db.Uuid
  location_id       String         @db.Uuid
  supplier_id       String         @db.Uuid
  purchase_order_id String?        @db.Uuid
  number            String         @db.VarChar(32)
  status            DocumentStatus @default(DRAFT)
  supplier_reference String?
  received_at       DateTime       @db.Timestamptz(6)
  notes             String?
  total_value       Decimal        @default(0) @db.Decimal(18, 2)
  posted_at         DateTime?      @db.Timestamptz(6)
  posted_by_id      String?        @db.Uuid
  journal_entry_id  String?        @db.Uuid
  idempotency_key   String?        @db.VarChar(80)
  created_by_id     String         @db.Uuid
  created_at        DateTime       @default(now()) @db.Timestamptz(6)

  lines GoodsReceiptLine[]

  @@unique([business_id, number])
  @@index([purchase_order_id])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                     String    @id @default(uuid()) @db.Uuid
  goods_receipt_id       String    @db.Uuid
  purchase_order_line_id String?   @db.Uuid
  line_no                Int
  variant_id             String    @db.Uuid
  unit_id                String    @db.Uuid
  unit_factor            Decimal   @db.Decimal(18, 3)
  qty_accepted           Decimal   @default(0) @db.Decimal(18, 3)
  qty_damaged            Decimal   @default(0) @db.Decimal(18, 3)
  qty_rejected           Decimal   @default(0) @db.Decimal(18, 3)
  accepted_base          Decimal   @default(0) @db.Decimal(18, 3)
  damaged_base           Decimal   @default(0) @db.Decimal(18, 3)
  rejected_base          Decimal   @default(0) @db.Decimal(18, 3)
  unit_cost              Decimal   @db.Decimal(18, 6)
  base_unit_cost         Decimal   @db.Decimal(18, 6)
  line_value             Decimal   @db.Decimal(18, 2)
  invoiced_base          Decimal   @default(0) @db.Decimal(18, 3)
  batch_number           String?
  expiry_date            DateTime? @db.Date
  serial_numbers         String[]  @default([])

  goods_receipt GoodsReceipt @relation(fields: [goods_receipt_id], references: [id], onDelete: Restrict)

  @@unique([goods_receipt_id, line_no])
  @@map("goods_receipt_lines")
}

model SupplierInvoice {
  id               String         @id @default(uuid()) @db.Uuid
  business_id      String         @db.Uuid
