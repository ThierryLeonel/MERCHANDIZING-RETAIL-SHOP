{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "paths": { "@retail/api-contracts": ["../../packages/api-contracts/src/index.ts"] }
  },
  "include": ["src"]
}
